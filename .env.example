# API keys: easiest is the ⚙ Settings button in the panel, which writes them here.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Models: a stronger one for answers, a fast one for question detection, talking points and summaries
ANSWER_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
# low = fastest first words; medium / high = more careful answers, slower to start
ANSWER_EFFORT=low

# Audio devices (optional). Run `python copilot.py --list-devices` to see names; partial names work.
# MIC_DEVICE=MacBook Pro Microphone
# SYSTEM_DEVICE=BlackHole 2ch

# Global "answer now" hotkey (pynput format). On Mac, try <cmd>+<shift>+a
HOTKEY=<ctrl>+<alt>+a
# DISABLE_HOTKEY=1

POINTS_EVERY_SEC=30
AUTO_COOLDOWN_SEC=8
# ECHO_FILTER=1          # start with the echo filter on (for calls without headphones)
PORT=8765
